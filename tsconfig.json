{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node", "vitepress/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["env.d.ts", "**/*.ts", "**/*.vue"],
  "exclude": ["node_modules", ".vitepress/generated", ".vitepress/dist"]
}
