{
  "name": "torchz-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Torchz 知识库 Web 浏览器：只读、私有、手机友好的 Markdown 知识库阅读层",
  "scripts": {
    "dev": "node scripts/dev.mjs",
