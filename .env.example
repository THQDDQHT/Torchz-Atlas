# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，不要提交。

# ── 知识库位置 ────────────────────────────────────────────────
# 容器内的只读挂载点。宿主机真实路径写在 docker-compose 的挂载源，不在这里暴露。
KNOWLEDGE_DIR=/knowledge

# ── 鉴权 ─────────────────────────────────────────────────────
# cf-access：校验 Cloudflare Access 签发的 JWT（生产必须用这个）
# none：不校验，仅允许服务绑定在回环地址时使用（本地开发 / SSH 隧道）
AUTH_MODE=none

# AUTH_MODE=cf-access 时必填，从 Cloudflare Zero Trust 控制台获取：
# team domain 形如 your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Access 应用的 Application Audience (AUD) Tag
CF_ACCESS_AUD=

# ── 站点 ─────────────────────────────────────────────────────
SITE_NAME=Torchz
SITE_DESCRIPTION=个人知识库 · 想法、项目、踩坑与好东西

# ── 部署（仅 docker-compose 使用，不进镜像）────────────────────
# 宿主机知识库目录，将以只读方式挂载到容器 /knowledge
HOST_KNOWLEDGE_DIR=/path/to/your/knowledge
# 容器以该 uid:gid 运行，必须能读取上面的知识库文件
RUN_AS=1000:1000
# 服务对外监听地址，生产务必绑定回环地址，由 Cloudflare Tunnel 转发
BIND_ADDR=127.0.0.1
BIND_PORT=8088
